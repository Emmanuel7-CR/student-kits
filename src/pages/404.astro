---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist.">
  <h1 class="text-3xl font-extrabold tracking-tight">Page not found</h1>
  <p class="mt-2 text-muted">The page you opened does not exist or has moved.</p>
  <div class="mt-4 flex flex-wrap gap-2">
    <a class="btn btn-primary" href="/">Go home</a>
    <a class="btn" href="/tools/">Browse tools</a>
    <a class="btn" href="/search/">Search</a>
  </div>
</Base>
