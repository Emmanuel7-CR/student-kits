---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import data from '../data/scholarships.json';
import {
  daysLabel,
  formatDate,
  groupFor,
  stateFor,
  todayInLagos,
  type Group,
  type Scholarship,
} from '../lib/scholarships';

const entries = data.entries as Scholarship[];
const today = todayInLagos();
const groups: Record<Group, Scholarship[]> = { open: [], check: [], past: [] };
for (const s of entries) groups[groupFor(s, today)].push(s);
const byDeadline = (a: Scholarship, b: Scholarship) => (a.deadline ?? '9999').localeCompare(b.deadline ?? '9999');
groups.open.sort(byDeadline);
groups.check.sort(byDeadline);
groups.past.sort((a, b) => byDeadline(b, a));

const sections: { key: Group; title: string; blurb: string }[] = [
  { key: 'open', title: 'Open now', blurb: 'Deadline still ahead, and the information is not contradicted.' },
  { key: 'check', title: 'Check before applying', blurb: 'The sources disagree or no deadline is known. Confirm on the official page first.' },
  { key: 'past', title: 'Past rounds', blurb: 'Closed for now. Use them to prepare early; next-round dates are only shown once announced.' },
];

const verifyLabel: Record<string, string> = {
  verified: 'Verified: an official page confirms this',
  reported: 'Reported: from news or a school notice',
  conflicting: 'Check before applying: sources disagree',
};
const verifyClass: Record<string, string> = { verified: 'badge badge-ok', reported: 'badge', conflicting: 'badge badge-warn' };
---

<Base
  title="Scholarships and student loans for Nigerians"
  description="Scholarships and loans for Nigerian students with deadlines, eligibility, official links and the sources we checked. Last checked 18 October 2026."
>
  <h1 class="text-3xl font-extrabold tracking-tight">Scholarships and loans</h1>
  <p class="mt-2 max-w-2xl text-muted">
    Last checked {formatDate(data.checkedOn)}. Each entry shows where the information came from, so you can confirm it on the
    official page before you apply.
  </p>

  <div class="mt-4 flex gap-3 rounded-xl border border-line px-4 py-3" style="background: var(--warn-bg); color: var(--warn-fg)" role="note">
    <Icon name="alert" size={22} class="mt-0.5 shrink-0" />
    <p class="text-sm font-semibold">Never pay anyone to apply. Genuine scholarships and loans do not charge application fees, and agents or “portal helpers” are a common scam.</p>
  </div>

  <details class="card mt-4">
    <summary class="cursor-pointer font-bold">What “Verified” and “Reported” mean</summary>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted">
      <li><strong class="text-ink">Verified:</strong> an official page of the provider or the Nigerian government confirms the details.</li>
      <li><strong class="text-ink">Reported:</strong> the details come from news articles or a school notice. Confirm on the official site.</li>
      <li><strong class="text-ink">Check before applying:</strong> sources disagree, for example a page that shows a deadline and also says applications have ended.</li>
    </ul>
  </details>

  {
    sections.map((sec) => (
      <section class="mt-8" data-section={sec.key} aria-labelledby={`h-${sec.key}`} hidden={groups[sec.key].length === 0}>
        <h2 id={`h-${sec.key}`} class="text-2xl font-bold">{sec.title}</h2>
        <p class="mt-1 text-sm text-muted">{sec.blurb}</p>
        <div class="mt-4 space-y-4" data-list={sec.key}>
          {groups[sec.key].map((s) => {
            const st = stateFor(s.deadline, today);
            return (
              <article class="card" data-id={s.id} data-deadline={s.deadline ?? ''} data-verification={s.verification}>
                <div class="flex flex-wrap items-center gap-2">
                  <span class={verifyClass[s.verification]}>{verifyLabel[s.verification]}</span>
                  {s.kind === 'loan' && <span class="badge badge-muted">Loan, repayable</span>}
                  <span class="badge badge-muted">{s.level}</span>
                </div>
                <h3 class="mt-2 text-xl font-bold">{s.name}</h3>
                <p class="text-sm text-muted">{s.provider}</p>
                <p class="mt-3 font-semibold">
                  {s.deadline ? `Deadline: ${formatDate(s.deadline)}` : 'No deadline given'}
                  {' · '}
                  <span data-role="days" class={st.state === 'soon' ? 'text-[color:var(--warn-fg)]' : ''}>{daysLabel(st.days)}</span>
                </p>
                <p class="text-sm text-muted">{s.deadlineNote}</p>
                <dl class="mt-3 space-y-2 text-sm">
                  <div><dt class="font-semibold">Who can apply</dt><dd class="text-muted">{s.who}</dd></div>
                  <div><dt class="font-semibold">What you get</dt><dd class="text-muted">{s.award}</dd></div>
                  <div><dt class="font-semibold">How to apply</dt><dd class="text-muted">{s.howToApply}</dd></div>
                </dl>
                <div class="mt-4 flex flex-wrap items-center gap-2">
                  {s.official && (
                    <a class="btn btn-primary" href={s.official.url} target="_blank" rel="noopener noreferrer">
                      {s.official.label} <Icon name="external" size={16} />
                    </a>
                  )}
                </div>
                <p class="mt-3 text-xs text-muted">
                  Sources we checked:{' '}
                  {s.sources.map((src, i) => (
                    <>
                      {i > 0 && ', '}
                      <a class="link" href={src.url} target="_blank" rel="noopener noreferrer">{src.label}</a>
                    </>
                  ))}
                  . Last checked {formatDate(data.checkedOn)}.
                </p>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }

  <p class="mt-8 text-sm text-muted">
    Missing a scholarship, or spotted a wrong date? Details change quickly, so always follow the official link above.
  </p>

  <script>
    // Dates move on after the site was built, so regroup and relabel using today's date in Nigeria.
    import { daysLabel, groupFor, stateFor, todayInLagos, type Scholarship } from '../lib/scholarships';

    const today = todayInLagos();
    const lists = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-list]').forEach((l) => lists.set(l.dataset.list!, l));
    const cards = [...document.querySelectorAll<HTMLElement>('article[data-id]')];

    for (const card of cards) {
      const deadline = card.dataset.deadline || null;
      const verification = card.dataset.verification as Scholarship['verification'];
      const st = stateFor(deadline, today);
      const days = card.querySelector<HTMLElement>('[data-role="days"]');
      if (days) {
        days.textContent = daysLabel(st.days);
        days.style.color = st.state === 'soon' ? 'var(--warn-fg)' : '';
      }
      lists.get(groupFor({ deadline, verification }, today))?.append(card);
    }
    // keep each list ordered: open and check by nearest deadline, past by most recent
    for (const [key, list] of lists) {
      const items = [...list.children] as HTMLElement[];
      items.sort((a, b) => {
        const da = a.dataset.deadline || '9999';
        const db = b.dataset.deadline || '9999';
        return key === 'past' ? db.localeCompare(da) : da.localeCompare(db);
      });
      list.replaceChildren(...items);
      const section = list.closest('section');
      if (section) section.hidden = items.length === 0;
    }
  </script>
</Base>
