---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---

<Base
  title="Exam Revision Timetable and Countdown"
  description="Enter your exam dates and how many hours you can study each day. Get a day-by-day revision timetable that gives harder and sooner exams more time. Free and private."
>
  <nav class="mb-3 text-sm no-print" aria-label="Breadcrumb">
    <a class="link" href="/tools/">Tools</a> <span class="text-muted">/</span> <span>Exam Revision Timetable</span>
  </nav>
  <h1 class="text-3xl font-extrabold tracking-tight no-print">Exam Revision Timetable</h1>
  <p class="mt-2 max-w-2xl text-muted no-print">
    Add your exams and the hours you can really study each day. The plan gives more time to harder exams and to exams that
    are close. It is a starting point, so move things around to suit your week.
  </p>

  <div class="mt-6 grid gap-6 lg:grid-cols-[24rem_1fr]">
    <form class="card space-y-3 no-print" novalidate onsubmit="return false">
      <h2 class="text-lg font-bold">Your exams</h2>
      <div id="sp-exams" class="grid gap-3"></div>
      <button id="sp-add" type="button" class="btn"><Icon name="plus" size={18} /> Add an exam</button>
      <div class="grid grid-cols-2 gap-3 pt-2">
        <label class="field"><span class="label">Hours a day</span><select id="sp-hours" class="select"></select></label>
        <label class="field"><span class="label">Rest day</span>
          <select id="sp-rest" class="select">
            <option value="-1">None</option>
            <option value="0">Sunday</option>
            <option value="1">Monday</option>
            <option value="2">Tuesday</option>
            <option value="3">Wednesday</option>
            <option value="4">Thursday</option>
            <option value="5">Friday</option>
            <option value="6">Saturday</option>
          </select>
        </label>
        <label class="field col-span-2"><span class="label">Start from</span><input id="sp-today" class="input" type="date" /></label>
      </div>
      <p class="text-sm text-muted">Saved on this device. A rest day is kept free unless an exam is that day or the next.</p>
    </form>

    <div>
      <p id="sp-msg" class="mb-3 text-sm no-print" role="status" aria-live="polite"></p>
      <section id="sp-counts" class="grid gap-2 sm:grid-cols-2 no-print" aria-label="Countdown"></section>
      <section id="sp-out" class="mt-4" hidden>
        <div class="print-area card" style="background:#fff;color:#111;">
          <h2 class="text-lg font-bold">Revision timetable</h2>
          <p id="sp-totals" class="mt-1 text-sm"></p>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full border-collapse text-sm" id="sp-table">
              <thead>
                <tr><th class="border border-border p-2 text-left">Date</th><th class="border border-border p-2 text-left">Plan</th></tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2 no-print">
          <button id="sp-print" type="button" class="btn btn-primary"><Icon name="printer" size={18} /> Print or save as PDF</button>
          <button id="sp-copy" type="button" class="btn"><Icon name="copy" size={18} /> Copy as text</button>
        </div>
      </section>
    </div>
  </div>

  <noscript><p class="mt-6">This tool needs JavaScript to run.</p></noscript>

  <script>
    import '../../scripts/study-ui';
  </script>
</Base>
