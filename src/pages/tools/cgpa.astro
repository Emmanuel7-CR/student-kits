---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---

<Base
  title="CGPA Calculator (4.0 and 5.0 scale)"
  description="Free CGPA calculator for Nigerian students. Choose the 4-point or 5-point scale, add many semesters, see your degree class and plan the GPA you need next."
>
  <nav class="mb-3 text-sm" aria-label="Breadcrumb">
    <a class="link" href="/tools/">Tools</a> <span class="text-muted">/</span> <span>CGPA Calculator</span>
  </nav>
  <h1 class="text-3xl font-extrabold tracking-tight">CGPA Calculator</h1>
  <p class="mt-2 max-w-2xl text-muted">
    Choose your school's grading scale, add your courses semester by semester, and see your CGPA and degree class.
  </p>

  <div class="mt-6 grid gap-6 pb-12 md:pb-0 lg:grid-cols-[1fr_20rem]">
    <div class="space-y-6 print-area">
      <section class="card" aria-labelledby="scale-h">
        <h2 id="scale-h" class="text-lg font-bold">1. Grading scale</h2>
        <fieldset class="mt-3">
          <legend class="sr-only">Grading scale</legend>
          <div class="grid grid-cols-2 gap-2">
            <label class="btn cursor-pointer has-[:checked]:bg-brand has-[:checked]:text-[color:var(--on-primary)] has-[:checked]:border-[color:var(--primary)]">
              <input type="radio" name="scale" value="5" class="sr-only" checked />
              5-point scale
            </label>
            <label class="btn cursor-pointer has-[:checked]:bg-brand has-[:checked]:text-[color:var(--on-primary)] has-[:checked]:border-[color:var(--primary)]">
              <input type="radio" name="scale" value="4" class="sr-only" />
              4-point scale
            </label>
          </div>
        </fieldset>
        <p class="mt-3 text-sm"><strong>Grade points:</strong> <span id="grade-key"></span></p>
        <p id="scale-note" class="mt-1 text-sm text-muted"></p>
        <p id="scale-notice" class="mt-2 text-sm font-semibold" role="status" aria-live="polite"></p>
      </section>

      <details class="card">
        <summary class="cursor-pointer text-lg font-bold">Already have results from earlier levels? (optional)</summary>
        <p class="mt-2 text-sm text-muted">
          Enter your CGPA and total credit units so far, and the semesters below are added on top of them.
        </p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="field">
            <span class="label">CGPA so far</span>
            <input id="prior-cgpa" class="input" type="number" inputmode="decimal" min="0" max="5" step="0.01" placeholder="e.g. 3.85" />
          </label>
          <label class="field">
            <span class="label">Credit units so far</span>
            <input id="prior-units" class="input" type="number" inputmode="numeric" min="0" step="1" placeholder="e.g. 72" />
          </label>
        </div>
      </details>

      <section aria-labelledby="sem-h">
        <h2 id="sem-h" class="mb-3 text-lg font-bold">2. Your semesters</h2>
        <div id="semesters" class="space-y-4"></div>
        <button id="add-semester" type="button" class="btn btn-primary mt-4 no-print">
          <Icon name="plus" size={18} /> Add semester
        </button>
      </section>

      <section class="card no-print" aria-labelledby="plan-h">
        <h2 id="plan-h" class="text-lg font-bold">3. Target planner</h2>
        <p class="mt-1 text-sm text-muted">Work out the GPA you need next semester to reach the CGPA you want.</p>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="field">
            <span class="label">Current CGPA</span>
            <input id="plan-cgpa" class="input" type="number" inputmode="decimal" min="0" step="0.01" />
          </label>
          <label class="field">
            <span class="label">Units completed so far</span>
            <input id="plan-units" class="input" type="number" inputmode="numeric" min="0" step="1" />
          </label>
          <label class="field">
            <span class="label">Units you will take next</span>
            <input id="plan-next" class="input" type="number" inputmode="numeric" min="1" step="1" />
          </label>
          <label class="field">
            <span class="label">Target CGPA (max <span id="plan-max">5</span>)</span>
            <input id="plan-target" class="input" type="number" inputmode="decimal" min="0" step="0.01" />
          </label>
        </div>
        <button id="use-my-numbers" type="button" class="btn mt-3">Use my numbers from above</button>
        <p id="plan-out" class="result-box mt-4" role="status" aria-live="polite"></p>
      </section>
    </div>

    <aside class="lg:sticky lg:top-20 lg:self-start" aria-label="Your result">
      <div class="card">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-muted">Your CGPA</h2>
        <p id="cgpa-value" class="text-5xl font-extrabold tabular-nums text-brand-strong" role="status" aria-live="polite">–</p>
        <p id="cgpa-class" class="mt-1 font-semibold"></p>
        <p id="cgpa-detail" class="mt-1 text-sm text-muted"></p>
        <div class="mt-4 flex flex-wrap gap-2 no-print">
          <button id="copy-summary" type="button" class="btn"><Icon name="copy" size={18} /> <span>Copy summary</span></button>
          <button id="print-page" type="button" class="btn"><Icon name="printer" size={18} /> Print</button>
          <button id="clear-all" type="button" class="btn btn-quiet"><Icon name="trash" size={18} /> Clear all</button>
        </div>
        <p id="save-note" class="mt-3 text-xs text-muted no-print"></p>
      </div>
      <p class="mt-3 text-sm text-muted no-print">
        Switching scale keeps your letter grades, so this also shows how the same results look on the other scale. Schools
        differ, so use the official result from your school for anything formal.
      </p>
    </aside>
  </div>

  <div
    id="mini-result"
    class="no-print fixed inset-x-0 z-30 md:hidden"
    style="bottom: calc(3.5rem + env(safe-area-inset-bottom))"
    hidden
  >
    <div class="mx-auto max-w-5xl px-4">
      <div class="flex items-center justify-between gap-3 rounded-t-xl bg-brand px-4 py-2" style="color: var(--on-primary)">
        <span id="mini-value" class="text-lg font-extrabold tabular-nums"></span>
        <span id="mini-class" class="text-right text-sm font-semibold"></span>
      </div>
    </div>
  </div>

  <script>
    import '../../scripts/cgpa-ui.ts';
  </script>
</Base>
