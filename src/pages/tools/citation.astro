---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---

<Base
  title="Citation Generator (APA 7, MLA 9, Harvard)"
  description="Free reference generator for books, journal articles and websites in APA 7, MLA 9 and Harvard style. It tells you what is missing instead of inventing details."
>
  <nav class="mb-3 text-sm" aria-label="Breadcrumb">
    <a class="link" href="/tools/">Tools</a> <span class="text-muted">/</span> <span>Citation Generator</span>
  </nav>
  <h1 class="text-3xl font-extrabold tracking-tight">Citation Generator</h1>
  <p class="mt-2 max-w-2xl text-muted">
    Fill in what you have. The reference updates as you type, and the tool tells you what is missing instead of making
    details up.
  </p>

  <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <form id="cite-form" class="card space-y-4" novalidate>
      <div class="rounded-lg border border-border p-3">
        <label class="field">
          <span class="label">Fill it in for me (optional)</span>
          <div class="flex gap-2">
            <input id="c-lookup" class="input" type="text" inputmode="url" autocomplete="off" placeholder="DOI or ISBN" aria-describedby="c-lookup-hint" />
            <button id="c-lookup-go" type="button" class="btn shrink-0">Look up</button>
          </div>
          <span id="c-lookup-hint" class="hint">Paste a DOI (10.1234/abc) or a book ISBN. Needs data. Always check what it returns.</span>
        </label>
        <p id="c-lookup-msg" class="mt-2 text-sm" role="status" aria-live="polite" hidden></p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <label class="field">
          <span class="label">Style</span>
          <select id="c-style" class="select">
            <option value="apa">APA 7th</option>
            <option value="mla">MLA 9th</option>
            <option value="harvard">Harvard</option>
          </select>
        </label>
        <label class="field">
          <span class="label">Source type</span>
          <select id="c-type" class="select">
            <option value="book">Book</option>
            <option value="journal">Journal article</option>
            <option value="website">Website</option>
          </select>
        </label>
      </div>

      <label class="field">
        <span class="label">Authors</span>
        <textarea id="c-authors" class="textarea" rows="3" placeholder={'Okafor, Chinedu Nnamdi\nBello, Aisha'}></textarea>
        <span class="hint">One author per line, as “Last, First” or “First Last”. Leave empty for a website with no author.</span>
      </label>

      <div class="grid grid-cols-2 gap-3">
        <label class="field">
          <span class="label">Year</span>
          <input id="c-year" class="input" type="text" inputmode="numeric" maxlength="12" placeholder="2024" />
        </label>
        <label class="field" data-for="journal">
          <span class="label">Volume</span>
          <input id="c-volume" class="input" type="text" />
        </label>
        <label class="field" data-for="journal">
          <span class="label">Issue</span>
          <input id="c-issue" class="input" type="text" />
        </label>
        <label class="field" data-for="journal">
          <span class="label">Pages</span>
          <input id="c-pages" class="input" type="text" placeholder="45-60" />
        </label>
        <label class="field" data-for="book">
          <span class="label">Edition (optional)</span>
          <input id="c-edition" class="input" type="text" placeholder="2nd" />
        </label>
        <label class="field" data-for="book" data-style="harvard">
          <span class="label">Place (Harvard)</span>
          <input id="c-place" class="input" type="text" placeholder="Lagos" />
        </label>
      </div>

      <label class="field">
        <span class="label" id="c-title-label">Title</span>
        <input id="c-title" class="input" type="text" />
      </label>
      <label class="field" data-for="book website">
        <span class="label" id="c-pub-label">Publisher</span>
        <input id="c-publisher" class="input" type="text" />
      </label>
      <label class="field" data-for="journal">
        <span class="label">Journal name</span>
        <input id="c-journal" class="input" type="text" />
      </label>
      <label class="field" data-for="journal book">
        <span class="label">DOI (optional)</span>
        <input id="c-doi" class="input" type="text" placeholder="10.1234/example" />
      </label>
      <label class="field" data-for="website journal book">
        <span class="label">Web address (URL)</span>
        <input id="c-url" class="input" type="url" inputmode="url" placeholder="https://" />
      </label>
      <label class="field" data-for="website">
        <span class="label">Date you visited it</span>
        <input id="c-accessed" class="input" type="date" />
      </label>
    </form>

    <div class="space-y-4 lg:sticky lg:top-20 lg:self-start">
      <section class="card" aria-labelledby="ref-h">
        <h2 id="ref-h" class="text-lg font-bold">Your reference</h2>
        <p id="cite-out" class="result-box mt-3 break-words" role="status" aria-live="polite">Fill in the form to see your reference.</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button id="cite-copy" type="button" class="btn" disabled><Icon name="copy" size={18} /> <span>Copy reference</span></button>
        </div>
      </section>
      <p class="text-sm text-muted">
        Titles are shown as you type them, so apply your style's capitalisation yourself (APA and Harvard use sentence case for
        book and article titles). Always check against your department's guide.
      </p>
    </div>
  </div>

  <script>
    import { cite, type CiteInput } from '../../lib/citation';
    import { cleanIsbn, fromCrossref, fromOpenLibrary, normaliseDoi, type Filled } from '../../lib/lookup';
    import { copyText, el } from '../../scripts/dom';

    const $v = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement).value;
    const out = document.getElementById('cite-out') as HTMLElement;
    const copyBtn = document.getElementById('cite-copy') as HTMLButtonElement;
    const typeSel = document.getElementById('c-type') as HTMLSelectElement;
    const styleSel = document.getElementById('c-style') as HTMLSelectElement;
    let plain = '';

    function read(): CiteInput {
      return {
        style: $v('c-style') as CiteInput['style'],
        type: $v('c-type') as CiteInput['type'],
        authors: $v('c-authors'),
        year: $v('c-year'),
        title: $v('c-title'),
        publisher: $v('c-publisher'),
        edition: $v('c-edition'),
        place: $v('c-place'),
        journal: $v('c-journal'),
        volume: $v('c-volume'),
        issue: $v('c-issue'),
        pages: $v('c-pages'),
        doi: $v('c-doi'),
        url: $v('c-url'),
        accessed: $v('c-accessed'),
      };
    }

    function toggleFields() {
      const type = typeSel.value;
      const style = styleSel.value;
      document.querySelectorAll<HTMLElement>('[data-for]').forEach((f) => {
        const types = f.dataset.for!.split(' ');
        const styleOnly = f.dataset.style;
        f.hidden = !types.includes(type) || (styleOnly !== undefined && styleOnly !== style);
      });
      document.getElementById('c-pub-label')!.textContent = type === 'website' ? 'Website name' : 'Publisher';
      document.getElementById('c-title-label')!.textContent =
        type === 'journal' ? 'Article title' : type === 'website' ? 'Page title' : 'Book title';
    }

    function render() {
      const r = cite(read());
      const empty = !$v('c-title') && !$v('c-authors') && !$v('c-publisher') && !$v('c-journal');
      if (!r.ok) {
        plain = '';
        copyBtn.disabled = true;
        out.textContent = empty ? 'Fill in the form to see your reference.' : `Still needed: ${r.missing.join(', ')}.`;
        return;
      }
      plain = r.plain;
      copyBtn.disabled = false;
      out.replaceChildren(...r.segments.map((s) => (s.italic ? el('i', {}, s.text) : document.createTextNode(s.text))));
    }

    document.getElementById('cite-form')!.addEventListener('input', () => {
      toggleFields();
      render();
    });
    document.getElementById('cite-form')!.addEventListener('submit', (e) => e.preventDefault());

    copyBtn.addEventListener('click', async () => {
      const ok = await copyText(plain);
      const label = copyBtn.querySelector('span')!;
      label.textContent = ok ? 'Copied (plain text; italicise titles in your document)' : 'Copy not available here';
      setTimeout(() => (label.textContent = 'Copy reference'), 2500);
    });

    const lookupMsg = document.getElementById('c-lookup-msg') as HTMLElement;
    const lookupBtn = document.getElementById('c-lookup-go') as HTMLButtonElement;
    const form = document.getElementById('cite-form') as HTMLFormElement;
    const FIELD_IDS: Record<keyof Filled, string> = {
      type: 'c-type', authors: 'c-authors', year: 'c-year', title: 'c-title', publisher: 'c-publisher', edition: 'c-edition',
      place: 'c-place', journal: 'c-journal', volume: 'c-volume', issue: 'c-issue', pages: 'c-pages', doi: 'c-doi', url: 'c-url',
    };

    function lookupSay(text: string) {
      lookupMsg.textContent = text;
      lookupMsg.hidden = !text;
    }

    function applyFilled(f: Filled) {
      // Start from a clean form so details from an earlier source do not linger.
      for (const id of Object.values(FIELD_IDS)) {
        if (id !== 'c-type') (document.getElementById(id) as HTMLInputElement).value = '';
      }
      for (const [key, value] of Object.entries(f) as [keyof Filled, string][]) {
        (document.getElementById(FIELD_IDS[key]) as HTMLInputElement).value = value;
      }
      form.dispatchEvent(new Event('input', { bubbles: true }));
    }

    async function getJson(url: string): Promise<unknown> {
      const ctl = new AbortController();
      const timer = setTimeout(() => ctl.abort(), 12000);
      try {
        const res = await fetch(url, { signal: ctl.signal, headers: { Accept: 'application/json' } });
        if (res.status === 404) return null;
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return await res.json();
      } finally {
        clearTimeout(timer);
      }
    }

    async function lookup() {
      const raw = (document.getElementById('c-lookup') as HTMLInputElement).value.trim();
      if (!raw) return lookupSay('Paste a DOI or an ISBN first.');
      const doi = normaliseDoi(raw);
      const isbn = doi ? null : cleanIsbn(raw);
      if (!doi && !isbn) {
        return lookupSay('That does not look like a DOI (starts with 10.) or a valid ISBN. Check for typing mistakes.');
      }
      lookupBtn.disabled = true;
      lookupSay('Looking it up…');
      try {
        let filled: Filled | null;
        if (doi) {
          const encoded = doi.split('/').map(encodeURIComponent).join('/');
          filled = fromCrossref(await getJson(`https://api.crossref.org/works/${encoded}`));
        } else {
          filled = fromOpenLibrary(await getJson(`https://openlibrary.org/api/books?bibkeys=ISBN:${isbn}&format=json&jscmd=data`), isbn!);
        }
        if (!filled) return lookupSay('Nothing found for that. Fill the form in by hand instead.');
        applyFilled(filled);
        lookupSay('Filled in. Check every field against the source, and fix capitalisation to match your style.');
      } catch {
        lookupSay('Could not reach the lookup service. Check your data connection and try again, or fill the form in by hand.');
      } finally {
        lookupBtn.disabled = false;
      }
    }
    lookupBtn.addEventListener('click', lookup);
    document.getElementById('c-lookup')!.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter') {
        e.preventDefault();
        lookup();
      }
    });

    toggleFields();
    render();
  </script>
</Base>
